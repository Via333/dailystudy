{
  "name": "daily-learning",
  "version": "1.0.0",
  "private": true,
  "description": "一个由 GitHub Actions 每日更新并由 GitHub Pages 托管的中文学习站。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/validate-content.mjs && node scripts/build-site.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "validate": "node scripts/validate-content.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "plan": "node scripts/plan-daily.mjs",
    "generate:api": "node scripts/generate-daily.mjs"
  },
  "keywords": [
    "daily-learning",
    "github-pages",
    "github-actions",
    "static-site"
  ],
  "license": "MIT"
}
