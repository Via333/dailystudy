            { "id": "aesthetics_creative_color_saturation", "title": "饱和度与注意强度" },
            { "id": "aesthetics_creative_color_material", "title": "材质、光线与触感" }
          ]
        },
        {
          "id": "aesthetics_creative_typography",
          "title": "字体与信息设计",
          "outcome": "能用字体、网格和层级组织复杂信息。",
          "units": [
            { "id": "aesthetics_creative_typography_personality", "title": "字体性格与语气" },
            { "id": "aesthetics_creative_typography_grid", "title": "网格与版面秩序" },
            { "id": "aesthetics_creative_typography_readability", "title": "可读性与阅读节奏" },
            { "id": "aesthetics_creative_typography_information", "title": "信息层级与视觉导航" }
          ]
        },
        {
          "id": "aesthetics_creative_narrative",
          "title": "叙事与符号",
          "outcome": "能分析图像如何通过符号、镜头和隐喻生成意义。",
