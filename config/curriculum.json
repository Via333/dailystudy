            { "id": "aesthetics_creative_narrative_frame", "title": "镜头、瞬间与前后文" },
            { "id": "aesthetics_creative_narrative_emotion", "title": "情绪路径与观看体验" }
          ]
        },
        {
          "id": "aesthetics_creative_method",
          "title": "创意方法与文化判断",
          "outcome": "能有意识地产生、筛选和修正创意方案。",
          "units": [
            { "id": "aesthetics_creative_method_diverge", "title": "发散、联想与素材采集" },
            { "id": "aesthetics_creative_method_combine", "title": "组合、类比与概念变形" },
