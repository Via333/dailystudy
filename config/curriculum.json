      "principles": [
        "先观察具体视觉关系，再给出审美评价",
        "形式判断必须联系内容、媒介与观看情境",
        "练习从模仿规律走向有目的的选择"
      ],
      "newsEligible": false,
      "stages": [
        {
          "id": "aesthetics_creative_language",
          "title": "视觉语言基础",
          "outcome": "能识别并描述构成画面的基本视觉元素。",
          "units": [
            { "id": "aesthetics_creative_language_point_line", "title": "点、线与视线运动" },
            { "id": "aesthetics_creative_language_shape", "title": "形状、轮廓与识别" },
            { "id": "aesthetics_creative_language_scale", "title": "尺度、比例与对比" },
            { "id": "aesthetics_creative_language_weight", "title": "视觉重量与画面重心" }
          ]
        },
        {
