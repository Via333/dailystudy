    {
      "module": "consumer_psychology",
      "goal": "理解消费者从需求产生到购买后评价的心理机制，并将其转化为研究、产品、传播和实验设计。",
      "principles": [
        "从真实情境和行为证据出发，不把偏好陈述当作事实",
        "先解释心理机制，再讨论营销应用",
        "所有行为设计都要检查边界、长期效果与伦理代价"
      ],
      "newsEligible": false,
      "stages": [
        {
          "id": "consumer_psychology_journey",
          "title": "消费者决策旅程",
          "outcome": "能把一次消费行为还原为连续的情境、任务、选择和反馈。",
          "units": [
            { "id": "consumer_psychology_journey_need", "title": "需求识别与触发情境" },
            { "id": "consumer_psychology_journey_jobs", "title": "消费者想完成的任务" },
            { "id": "consumer_psychology_journey_consideration", "title": "考虑集与替代方案" },
            { "id": "consumer_psychology_journey_post_purchase", "title": "购买后评价、满意与忠诚" }
          ]
        },
        {
          "id": "consumer_psychology_attention",
          "title": "注意与感知",
          "outcome": "能判断信息如何进入注意、被感知并形成第一印象。",
          "units": [
            { "id": "consumer_psychology_attention_selective", "title": "选择性注意与目标过滤" },
            { "id": "consumer_psychology_attention_salience", "title": "显著性与视觉竞争" },
            { "id": "consumer_psychology_attention_fluency", "title": "知觉流畅性与理解成本" },
            { "id": "consumer_psychology_attention_novelty", "title": "适应、新奇与注意衰减" }
          ]
        },
        {
          "id": "consumer_psychology_memory",
          "title": "学习与记忆",
          "outcome": "能设计更容易被学习、储存和提取的品牌与产品信息。",
          "units": [
            { "id": "consumer_psychology_memory_association", "title": "联结学习与品牌联系" },
            { "id": "consumer_psychology_memory_encoding", "title": "编码、储存与提取" },
            { "id": "consumer_psychology_memory_schema", "title": "图式、分类与预期" },
            { "id": "consumer_psychology_memory_availability", "title": "心智可得性与熟悉效应" }
          ]
        },
        {
          "id": "consumer_psychology_motivation",
          "title": "动机、情绪与身份",
          "outcome": "能解释消费者为什么行动，以及情绪和身份如何改变价值判断。",
          "units": [
            { "id": "consumer_psychology_motivation_approach", "title": "趋近目标与回避目标" },
            { "id": "consumer_psychology_motivation_intrinsic", "title": "内在动机与外在动机" },
            { "id": "consumer_psychology_motivation_affect", "title": "情绪启发与感受即信息" },
            { "id": "consumer_psychology_motivation_identity", "title": "身份表达与自我一致性" }
          ]
        },
        {
          "id": "consumer_psychology_attitude",
          "title": "态度形成与说服",
          "outcome": "能解释信念如何形成态度，以及不同涉入程度下什么信息更可能改变判断与行动。",
          "units": [
            { "id": "consumer_psychology_attitude_belief", "title": "信念、评价与态度形成" },
            { "id": "consumer_psychology_attitude_elaboration", "title": "高涉入与低涉入的信息加工" },
            { "id": "consumer_psychology_attitude_credibility", "title": "来源、论据与信息可信度" },
            { "id": "consumer_psychology_attitude_behavior", "title": "态度—行为差距与心理抗拒" }
          ]
        },
        {
          "id": "consumer_psychology_choice",
          "title": "判断与选择架构",
          "outcome": "能识别选择环境如何改变比较、风险感受和最终行动。",
          "units": [
            { "id": "consumer_psychology_choice_reference", "title": "参照点与损失厌恶" },
            { "id": "consumer_psychology_choice_framing", "title": "锚定、框架与价格判断" },
            { "id": "consumer_psychology_choice_default", "title": "默认选项与现状偏好" },
            { "id": "consumer_psychology_choice_overload", "title": "选择过载与决策摩擦" }
          ]
        },
        {
          "id": "consumer_psychology_social",
          "title": "社会影响与文化",
          "outcome": "能解释他人、群体和文化规范如何塑造消费判断。",
          "units": [
            { "id": "consumer_psychology_social_norms", "title": "社会认同与群体规范" },
            { "id": "consumer_psychology_social_authority", "title": "权威、专业性与信任" },
            { "id": "consumer_psychology_social_scarcity", "title": "稀缺、互惠与行动压力" },
            { "id": "consumer_psychology_social_culture", "title": "群体身份与文化语境" }
          ]
        },
        {
          "id": "consumer_psychology_design",
          "title": "行为设计、验证与伦理",
          "outcome": "能把心理假设转化为可检验的行为设计，并控制伦理风险。",
          "units": [
            { "id": "consumer_psychology_design_comb", "title": "COM-B 行为模型" },
            { "id": "consumer_psychology_design_prompt", "title": "提示、能力与动机设计" },
            { "id": "consumer_psychology_design_experiment", "title": "行为实验与因果检验" },
            { "id": "consumer_psychology_design_ethics", "title": "暗黑模式、消费者福祉与长期信任" }
          ]
        }
      ]
    },
    {
      "module": "brand_product_research",
      "goal": "从市场和用户问题出发，用研究证据形成品牌定位、产品判断与优先级。",
      "principles": [
        "研究必须服务于一个明确决策",
        "优先观察真实行为，再解释态度和偏好",
        "洞察要能改变产品、品牌或资源配置"
      ],
      "newsEligible": false,
      "stages": [
        {
          "id": "brand_product_research_problem",
          "title": "市场与问题定义",
          "outcome": "能划定市场边界，并把模糊需求转成可研究问题。",
          "units": [
            { "id": "brand_product_research_problem_market", "title": "市场边界与需求空间" },
            { "id": "brand_product_research_problem_jobs", "title": "用户任务与进步" },
            { "id": "brand_product_research_problem_alternatives", "title": "竞争对象与替代方案" },
            { "id": "brand_product_research_problem_priority", "title": "问题价值与研究优先级" }
          ]
        },
        {
          "id": "brand_product_research_design",
          "title": "研究设计",
          "outcome": "能选择与决策风险相匹配的研究问题、样本和方法。",
          "units": [
            { "id": "brand_product_research_design_question", "title": "研究问题与决策问题" },
            { "id": "brand_product_research_design_hypothesis", "title": "假设、未知与证伪标准" },
            { "id": "brand_product_research_design_sample", "title": "样本选择与代表边界" },
            { "id": "brand_product_research_design_triangulation", "title": "多方法证据三角验证" }
          ]
        },
        {
          "id": "brand_product_research_qualitative",
          "title": "定性研究",
          "outcome": "能通过访谈和观察获得具体、可编码的行为证据。",
          "units": [
            { "id": "brand_product_research_qualitative_interview", "title": "深度访谈与提问顺序" },
            { "id": "brand_product_research_qualitative_context", "title": "情境观察与任务还原" },
            { "id": "brand_product_research_qualitative_probe", "title": "从意见追问到真实行为" },
            { "id": "brand_product_research_qualitative_coding", "title": "编码、模式与反例" }
          ]
        },
        {
