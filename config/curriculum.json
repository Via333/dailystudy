{
  "schemaVersion": 1,
  "startDate": "2026-08-08",
  "tracks": [
    {
      "module": "advertising_frontier",
      "goal": "理解广告系统、平台机制与测量方法，把投放操作提升为围绕商业目标的系统判断。",
      "principles": [
        "先理解商业目标，再讨论平台设置",
        "区分平台回传指标、业务结果与增量效果",
        "平台更新必须放回稳定的广告原理中判断"
      ],
      "newsEligible": true,
      "stages": [
        {
          "id": "advertising_frontier_system",
          "title": "广告系统基础",
          "outcome": "能解释广告生态中的参与者、价值交换和目标层级。",
          "units": [
            { "id": "advertising_frontier_system_roles", "title": "广告生态中的品牌、平台、媒体与用户" },
            { "id": "advertising_frontier_system_business_model", "title": "平台商业模式与注意力交易" },
            { "id": "advertising_frontier_system_inventory", "title": "媒体库存、版位与流量质量" },
            { "id": "advertising_frontier_system_objectives", "title": "业务目标、营销目标与平台目标" }
          ]
        },
        {
          "id": "advertising_frontier_delivery",
          "title": "竞价与投放机制",
          "outcome": "能判断一次广告展示如何被竞价、排序和预算系统共同决定。",
          "units": [
            { "id": "advertising_frontier_delivery_auction", "title": "竞价机制与广告排序" },
            { "id": "advertising_frontier_delivery_quality", "title": "质量信号与预估行动率" },
            { "id": "advertising_frontier_delivery_pacing", "title": "预算节奏与投放速度" },
            { "id": "advertising_frontier_delivery_learning", "title": "学习期、波动与稳定性" }
          ]
        },
        {
          "id": "advertising_frontier_strategy",
          "title": "策略与账户设计",
          "outcome": "能把用户任务、受众信号、创意假设和预算组合成清晰策略。",
          "units": [
            { "id": "advertising_frontier_strategy_funnel", "title": "用户任务与营销漏斗" },
            { "id": "advertising_frontier_strategy_audience", "title": "受众定义与信号质量" },
            { "id": "advertising_frontier_strategy_creative", "title": "创意假设与素材组合" },
            { "id": "advertising_frontier_strategy_budget", "title": "预算配置与边际回报" }
          ]
        },
        {
          "id": "advertising_frontier_measurement",
          "title": "衡量与归因",
          "outcome": "能选择与问题相匹配的归因、实验和增量测量方法。",
          "units": [
            { "id": "advertising_frontier_measurement_attribution", "title": "归因模型与归因窗口" },
            { "id": "advertising_frontier_measurement_incrementality", "title": "增量效果与反事实" },
            { "id": "advertising_frontier_measurement_experiment", "title": "广告实验与对照设计" },
            { "id": "advertising_frontier_measurement_mmm", "title": "营销组合模型与多渠道判断" }
          ]
        },
        {
          "id": "advertising_frontier_automation",
          "title": "自动化与数据",
          "outcome": "能为自动投放系统提供高质量目标、数据和约束。",
          "units": [
            { "id": "advertising_frontier_automation_bidding", "title": "智能出价的目标与边界" },
            { "id": "advertising_frontier_automation_first_party", "title": "第一方数据与信号治理" },
            { "id": "advertising_frontier_automation_privacy", "title": "隐私约束与测量变化" },
            { "id": "advertising_frontier_automation_ai", "title": "AI 执行与人的决策责任" }
          ]
        },
        {
          "id": "advertising_frontier_governance",
          "title": "行业变化与治理",
          "outcome": "能评估平台更新的影响，并用测试和预案管理变化。",
          "units": [
            { "id": "advertising_frontier_governance_update", "title": "平台更新的影响拆解" },
            { "id": "advertising_frontier_governance_migration", "title": "功能迁移与小规模测试" },
            { "id": "advertising_frontier_governance_risk", "title": "投放风险、异常与回退" },
            { "id": "advertising_frontier_governance_playbook", "title": "建立可复用的广告操作规范" }
          ]
        }
      ]
    },
    {
      "module": "marketing_case",
      "goal": "掌握结构化案例拆解方法，从商业问题、策略、执行和结果中提取可迁移规律。",
      "principles": [
        "先还原问题与约束，再评价创意",
        "区分事实、案例方主张与自己的推断",
        "每个案例最终都要说明适用条件和不可复制之处"
      ],
      "newsEligible": true,
      "stages": [
        {
          "id": "marketing_case_reading",
          "title": "案例阅读方法",
          "outcome": "能建立包含背景、问题、约束与证据的案例档案。",
          "units": [
            { "id": "marketing_case_reading_context", "title": "还原商业背景与市场环境" },
            { "id": "marketing_case_reading_problem", "title": "识别真正要解决的问题" },
            { "id": "marketing_case_reading_constraints", "title": "预算、时间与渠道约束" },
            { "id": "marketing_case_reading_evidence", "title": "案例证据的等级与可信度" }
          ]
        },
        {
          "id": "marketing_case_insight",
          "title": "洞察与策略",
          "outcome": "能判断洞察是否真实支撑了人群选择和策略命题。",
          "units": [
            { "id": "marketing_case_insight_tension", "title": "用户张力与未满足需求" },
            { "id": "marketing_case_insight_competition", "title": "竞争格局与替代方案" },
            { "id": "marketing_case_insight_audience", "title": "目标人群与优先级" },
            { "id": "marketing_case_insight_proposition", "title": "从洞察形成策略命题" }
          ]
        },
        {
          "id": "marketing_case_message",
          "title": "品牌与传播主张",
          "outcome": "能拆解案例中的价值主张、信任依据和品牌记忆资产。",
          "units": [
            { "id": "marketing_case_message_value", "title": "价值主张与用户收益" },
            { "id": "marketing_case_message_reason", "title": "可信理由与证据设计" },
            { "id": "marketing_case_message_assets", "title": "品牌资产与一致性" },
            { "id": "marketing_case_message_hierarchy", "title": "传播信息的层级与取舍" }
          ]
        },
        {
          "id": "marketing_case_architecture",
          "title": "Campaign 架构",
          "outcome": "能看清一场营销活动如何通过内容、渠道和参与机制逐步展开。",
          "units": [
            { "id": "marketing_case_architecture_event", "title": "把传播设计成事件" },
            { "id": "marketing_case_architecture_sequence", "title": "内容序列与悬念推进" },
            { "id": "marketing_case_architecture_channel", "title": "渠道角色与协同" },
            { "id": "marketing_case_architecture_participation", "title": "用户参与与社交扩散" }
          ]
        },
        {
          "id": "marketing_case_execution",
          "title": "执行与放大",
          "outcome": "能解释创意形式、媒体节奏和文化时机如何共同影响传播。",
          "units": [
            { "id": "marketing_case_execution_creative", "title": "创意表达与核心钩子" },
            { "id": "marketing_case_execution_media", "title": "媒介协同与触点节奏" },
            { "id": "marketing_case_execution_earned", "title": "赢得媒体与话题放大" },
            { "id": "marketing_case_execution_culture", "title": "文化语境与传播时机" }
          ]
        },
        {
          "id": "marketing_case_transfer",
          "title": "效果与迁移",
          "outcome": "能审查案例效果，并判断其中哪些原则可以迁移到自己的业务。",
          "units": [
            { "id": "marketing_case_transfer_business", "title": "业务结果与传播结果" },
            { "id": "marketing_case_transfer_causality", "title": "效果归因与因果边界" },
            { "id": "marketing_case_transfer_conditions", "title": "成功所需的前提条件" },
            { "id": "marketing_case_transfer_rebuild", "title": "为新问题重构案例方法" }
          ]
        }
      ]
    },
    {
      "module": "aesthetics_creative",
